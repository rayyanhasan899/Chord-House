# Export these in your shell (never commit actual credentials).
CHORD_ENVIRONMENT=development
CHORD_LOG_LEVEL=INFO
# CHORD_DATABASE_URL=postgresql+psycopg://USER:PASSWORD@127.0.0.1:5433/chord_house
# CHORD_DATABASE_URL_UNPOOLED=postgresql+psycopg://USER:PASSWORD@HOST:PORT/DATABASE
# Unpooled URL is used for migrations; application uses DATABASE_URL.

# Auth origins must match browser origin exactly. Production requires HTTPS origins + SMTP.
# CHORD_TRUSTED_ORIGINS=["http://127.0.0.1:3000","http://localhost:3000","http://127.0.0.1:8000"]
CHORD_AUTH_LIMIT=30
# CHORD_MAIL_DIRECTORY=.local-mail
# CHORD_SMTP_HOST=smtp.provider.example
# CHORD_SMTP_PORT=587
# CHORD_SMTP_USER=configure_locally
# CHORD_SMTP_PASSWORD=configure_locally
# CHORD_MAIL_FROM=your_verified_sender
