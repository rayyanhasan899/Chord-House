{
  "name": "chord-house",
  "private": true,
  "workspaces": [
    "frontend"
  ],
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "npm run dev --workspace frontend",
    "build": "npm run build --workspace frontend",
    "start": "npm run start --workspace frontend",
    "lint": "npm run lint --workspace frontend",
    "typecheck": "npm run typecheck --workspace frontend",
    "test": "npm run test --workspace frontend",
    "test:e2e": "npm run test:e2e --workspace frontend",
    "format": "prettier --write frontend scripts package.json .github",
    "format:check": "prettier --check frontend scripts package.json .github",
    "contracts:generate": "node scripts/contracts.mjs",
    "contracts:check": "node scripts/contracts.mjs --check",
    "security:audit": "node scripts/security-audit.mjs"
  },
  "devDependencies": {
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.6.2"
  }
}
